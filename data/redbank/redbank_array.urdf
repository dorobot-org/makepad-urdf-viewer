<?xml version="1.0"?>
<!-- Redbank III 4x8 array: every unit has a live bayonet-twist joint (±35°) -->
<robot name="redbank_iii_array">
  <link name="plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/array_frame.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="m"><color rgba="0.22 0.23 0.25 1.0"/></material>
